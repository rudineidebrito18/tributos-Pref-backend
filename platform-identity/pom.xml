<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.tributos</groupId>
    <artifactId>tributos-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-identity</artifactId>
  <packaging>jar</packaging>
  <name>platform-identity</name>
  <description>
    Bounded context de Identity &amp; Access: tenant, usuário, papel, permissão, auditoria.
    Arquitetura hexagonal: domain/ (puro) -&gt; application/ (casos de uso) -&gt;
    adapters/in/web (REST) e adapters/out/persistence (JPA) — ver PLANEJAMENTO_PROJETO.md §7.
  </description>

  <dependencies>
    <dependency>
      <groupId>br.com.tributos</groupId>
      <artifactId>shared-kernel</artifactId>
    </dependency>

    <!-- `provided`: os adapters usam anotações Spring/JPA, mas quem decide QUAL runtime
         (Spring Boot, versão de Hibernate) é o módulo executável (app-bootstrap), não este
         módulo de domínio — evita que platform-identity imponha uma versão de framework. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Só para codificação Base32 do segredo TOTP (RFC 4648) — evita reimplementar um
         codec e é dependência mínima, sem trazer nada de HTTP/JPA. -->
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
